# Build context whitelist: the root Dockerfile only needs requirements.txt;
# the ai_service build additionally needs the ASR model code.
*
!requirements.txt
!model.py
!serve_realtime_ws.py
!streaming_speaker_turns.py
!offline_asr_structure.py
!热词列表
!ai_service
!backend
backend/**
!backend/src
!backend/src/main
!backend/src/main/resources
!backend/src/main/resources/ai
!backend/src/main/resources/ai/role-assignment.json
!docker-models
ai_service/__pycache__
